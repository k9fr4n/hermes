# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env n'est jamais commite (voir .gitignore).
#
# Generer les secrets par exemple avec :
#   openssl rand -hex 16   # mot de passe dashboard
#   openssl rand -base64 32 # secret de session dashboard

# --- Authentification du dashboard (obligatoire) ---
# Le dashboard ecoute en 0.0.0.0 dans le conteneur (port publie + Traefik) :
# depuis le durcissement de juin 2026, un bind non-loopback exige toujours un
# fournisseur d'auth (fail-closed au demarrage sinon). Ici : user/password,
# reserve au LAN/VPN de confiance — pas d'exposition Internet directe.
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# --- Image a utiliser ---
# Defaut : derniere version stable publiee par NousResearch (amd64+arm64).
# Epingler une version precise si besoin (ex. v2026.8.31) :
#HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.31

# --- Noms de domaine Traefik (voir docker-compose.yml) ---
#HERMES_DASHBOARD_HOSTNAME=hermes-dashboard.ecritel.net
#HERMES_WEBAPP_HOSTNAME=hermes-webapp.ecritel.net

# --- Ports d'ecoute sur le Pi (defauts : 8642 / 9119 / 9120) ---
#HERMES_GATEWAY_PORT=8642
#HERMES_DASHBOARD_PORT=9119
#HERMES_WEBAPP_PORT=9120

# --- Proprietaire des fichiers data/ sur le Pi ---
#HERMES_UID=1000
#HERMES_GID=1000

# --- Cles API (optionnel, decommenter pour injecter depuis l'hote) ---
# De preference : les saisir dans le dashboard (page API Keys) ou via
# `docker compose exec hermes hermes config set ...` (stockees dans data/.env).
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
